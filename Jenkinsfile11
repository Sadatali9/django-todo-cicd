pipeline {
  agent any

  stages {
    stage('Build') {
      agent {
        docker { image 'python:3.10-slim' }
      }
      steps {
        sh 'python3 --version'
        echo 'Build environment verified. Proceeding to next stage...'
      }
    }

    stage('Deploy') {
      steps {
        sh 'docker build -t todo .'
        sh 'docker rm -f todo_container || true'
        sh 'docker run -d -p 8100:8000 --name todo_container todo'
      }
      post {
        always {
          sh 'docker stop todo_container || true'
          sh 'docker rm todo_container || true'
        }
      }
    }
  }

  post {
    success {
      echo 'Pipeline executed successfully'
    }
    failure {
      echo 'Pipeline execution failed'
    }
    always {
      echo 'Pipeline execution completed'
    }
  }
}
